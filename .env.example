# Documentation template only; the program reads process environment variables.
# Generate a random token of at least 32 ASCII characters. Do not commit it.
FARM_API_TOKEN=
FARM_BIND=127.0.0.1:8080
FARM_DATA_DIR=./data
FARM_LOG_DIR=./logs
RUST_LOG=farm_service=info
# Optional: leave unset to disable asset distribution. Sibling assets.zip required.
# The release files live in this repository's root assets/ directory.
# FARM_ASSET_MANIFEST=./assets/manifest.json
